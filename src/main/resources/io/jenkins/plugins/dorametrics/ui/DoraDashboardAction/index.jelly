<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
<l:layout title="DORA Metrics Dashboard" norefresh="true">
    <l:main-panel>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <link rel="stylesheet" href="${resURL}/plugin/pipeline-dora-metrics/css/dora-dashboard.css" type="text/css"/>

        <div class="dora-dashboard">
            <div class="dora-header">
                <h1>DORA Metrics Dashboard</h1>
                <div class="dora-controls">
                    <div class="dora-date-picker">
                        <button class="dora-date-btn" data-days="7">7d</button>
                        <button class="dora-date-btn active" data-days="30">30d</button>
                        <button class="dora-date-btn" data-days="90">90d</button>
                        <button class="dora-date-btn" data-days="180">180d</button>
                        <button class="dora-date-btn" data-days="365">1y</button>
                    </div>
                    <div class="dora-custom-date">
                        <input type="date" id="dora-from" />
                        <span>to</span>
                        <input type="date" id="dora-to" />
                        <button id="dora-apply-date">Apply</button>
                    </div>
                    <a class="dora-export-btn" href="../dora-api/export?format=csv" download="dora-metrics.csv">Export CSV</a>
                </div>
            </div>

            <!-- DORA Cards -->
            <div class="dora-cards">
                <j:set var="df" value="${it.deploymentFrequency}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Deployment Frequency</div>
                    <div class="dora-card-value">${df.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${df.band.color}">${df.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-df"></canvas>
                </div>

                <j:set var="leadTime" value="${it.leadTime}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Lead Time for Changes</div>
                    <div class="dora-card-value">${leadTime.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${leadTime.band.color}">${leadTime.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-lt"></canvas>
                </div>

                <j:set var="mttr" value="${it.mttr}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Mean Time to Restore</div>
                    <div class="dora-card-value">${mttr.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${mttr.band.color}">${mttr.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-mttr"></canvas>
                </div>

                <j:set var="cfr" value="${it.changeFailureRate}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Change Failure Rate</div>
                    <div class="dora-card-value">${cfr.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${cfr.band.color}">${cfr.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-cfr"></canvas>
                </div>
            </div>

            <!-- Trends -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>Trends</h2>
                    <span class="dora-section-toggle">&#9660;</span>
                </div>
                <div class="dora-section-body">
                    <div class="dora-chart-grid">
                        <div class="dora-chart-card">
                            <h3>Build Volume and Success Rate</h3>
                            <canvas id="chart-builds"></canvas>
                        </div>
                        <div class="dora-chart-card">
                            <h3>Average Build Duration (seconds)</h3>
                            <canvas id="chart-duration"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pipeline Rankings -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>Pipeline Rankings</h2>
                    <span class="dora-section-toggle">&#9660;</span>
                </div>
                <div class="dora-section-body">
                    <div class="dora-tables">
                        <div class="dora-table-wrap">
                            <h3>Slowest Pipelines</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Avg Duration</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.slowestPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Most Failing Pipelines</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Failure Rate</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.mostFailingPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Most Improved (vs Previous Period)</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Change</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.mostImprovedPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Flakiest Pipelines</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Flaky Score</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.flakiestPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stage Analytics -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>Stage Analytics</h2>
                    <span class="dora-section-toggle">&#9660;</span>
                </div>
                <div class="dora-section-body">
                    <div class="dora-tables">
                        <div class="dora-table-wrap">
                            <h3>Slowest Stages</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Stage</th><th class="v">Avg Duration</th><th class="v">Runs</th></tr>
                                <j:forEach var="s" items="${it.slowestStages}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td>${s.stageName}</td><td class="v">${s.displayValue}</td><td class="v">${s.occurrences}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Most Failing Stages</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Stage</th><th class="v">Failure Rate</th><th class="v">Runs</th></tr>
                                <j:forEach var="s" items="${it.mostFailingStages}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td>${s.stageName}</td><td class="v">${s.displayValue}</td><td class="v">${s.occurrences}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- API -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>REST API</h2>
                    <span class="dora-section-toggle collapsed">&#9660;</span>
                </div>
                <div class="dora-section-body collapsed" style="max-height:0">
                    <div class="dora-api-info">
                        <p style="font-size:12px; margin:4px 0;">
                            <code>GET /dora-api/overview?days=30</code> All 4 DORA metrics<br/>
                            <code>GET /dora-api/pipelines?days=30&amp;limit=10</code> Pipeline rankings<br/>
                            <code>GET /dora-api/trends?days=90&amp;job=my-pipeline</code> Time-series data<br/>
                            <code>GET /dora-api/export?days=90&amp;format=csv</code> CSV/JSON export
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <script src="${resURL}/plugin/pipeline-dora-metrics/js/dora-dashboard.js"></script>
    </l:main-panel>
</l:layout>
</j:jelly>
