<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
<l:layout title="DORA Metrics Dashboard" norefresh="true">
    <l:main-panel>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <style>
            .dora-dashboard { max-width: 1440px; margin: 0 auto; padding: 24px; }

            .dora-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
            .dora-header h1 { font-size: 22px; font-weight: 600; margin: 0; }
            .dora-controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
            .dora-date-picker { display: flex; gap: 2px; border: 1px solid #ccc; border-radius: 4px; padding: 2px; }
            .dora-date-btn { border: none; background: transparent; padding: 5px 12px; border-radius: 3px; font-size: 12px; font-weight: 500; cursor: pointer; color: #666; }
            .dora-date-btn:hover { background: #eee; }
            .dora-date-btn.active { background: #4b758b; color: #fff; }
            .dora-custom-date { display: flex; gap: 4px; align-items: center; font-size: 12px; }
            .dora-custom-date input { padding: 4px 8px; border: 1px solid #ccc; border-radius: 3px; font-size: 12px; }
            .dora-custom-date button { padding: 4px 10px; border: 1px solid #ccc; border-radius: 3px; font-size: 12px; cursor: pointer; background: #fff; }
            .dora-custom-date button:hover { background: #eee; }
            .dora-export-btn { border: 1px solid #ccc; background: #fff; padding: 5px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; text-decoration: none; color: inherit; }
            .dora-export-btn:hover { background: #f5f5f5; }

            .dora-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
            .dora-card { background: #fff; border: 1px solid #ccc; border-radius: 6px; padding: 18px; position: relative; overflow: hidden; }
            .dora-card-label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
            .dora-card-value { font-size: 28px; font-weight: 700; margin-bottom: 6px; line-height: 1.1; }
            .dora-card-band { display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 10px; color: #fff; }
            .dora-sparkline { position: absolute; bottom: 0; right: 0; width: 110px; height: 36px; opacity: 0.4; }

            .dora-section { margin-bottom: 20px; }
            .dora-section-header { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #ddd; margin-bottom: 14px; cursor: pointer; user-select: none; }
            .dora-section-header h2 { font-size: 15px; font-weight: 600; margin: 0; }
            .dora-section-toggle { font-size: 14px; color: #999; transition: transform 0.2s; }
            .dora-section-toggle.collapsed { transform: rotate(-90deg); }
            .dora-section-body { overflow: hidden; transition: max-height 0.3s ease; }
            .dora-section-body.collapsed { max-height: 0 !important; }

            .dora-chart-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 20px; }
            .dora-chart-card { background: #fff; border: 1px solid #ccc; border-radius: 6px; padding: 14px; }
            .dora-chart-card h3 { font-size: 12px; font-weight: 600; margin: 0 0 10px 0; color: #666; }
            .dora-chart-card canvas { max-height: 200px; }

            .dora-tables { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
            .dora-table-wrap { background: #fff; border: 1px solid #ccc; border-radius: 6px; padding: 14px; }
            .dora-table-wrap h3 { font-size: 12px; font-weight: 600; margin: 0 0 10px 0; color: #666; }
            table.dora-table { width: 100%; border-collapse: collapse; font-size: 12px; table-layout: fixed; }
            table.dora-table th { text-align: left; padding: 5px 6px; border-bottom: 2px solid #ddd; color: #888; font-weight: 500; font-size: 10px; text-transform: uppercase; }
            table.dora-table td { padding: 5px 6px; border-bottom: 1px solid #eee; vertical-align: middle; }
            table.dora-table tr:last-child td { border-bottom: none; }
            table.dora-table tr:hover td { background: #fafafa; }
            table.dora-table .r { color: #999; width: 24px; text-align: center; }
            table.dora-table .jn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            table.dora-table .jn a { color: inherit; text-decoration: none; }
            table.dora-table .jn a:hover { text-decoration: underline; }
            table.dora-table .v { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
            table.dora-table col.col-rank { width: 30px; }
            table.dora-table col.col-name { width: auto; }
            table.dora-table col.col-val { width: 90px; }
            table.dora-table col.col-count { width: 50px; }

            .dora-api-info { background: #f8f8f8; border: 1px solid #ccc; border-radius: 6px; padding: 14px; }
            .dora-api-info code { background: #eee; padding: 2px 5px; border-radius: 3px; font-size: 11px; }
        </style>

        <div class="dora-dashboard">
            <div class="dora-header">
                <h1>DORA Metrics Dashboard</h1>
                <div class="dora-controls">
                    <div class="dora-date-picker">
                        <button class="dora-date-btn" data-days="7">7d</button>
                        <button class="dora-date-btn active" data-days="30">30d</button>
                        <button class="dora-date-btn" data-days="90">90d</button>
                        <button class="dora-date-btn" data-days="180">180d</button>
                        <button class="dora-date-btn" data-days="365">1y</button>
                    </div>
                    <div class="dora-custom-date">
                        <input type="date" id="dora-from" />
                        <span>to</span>
                        <input type="date" id="dora-to" />
                        <button id="dora-apply-date">Apply</button>
                    </div>
                    <a class="dora-export-btn" href="../dora-api/export?format=csv" download="dora-metrics.csv">Export CSV</a>
                </div>
            </div>

            <!-- DORA Cards -->
            <div class="dora-cards">
                <j:set var="df" value="${it.deploymentFrequency}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Deployment Frequency</div>
                    <div class="dora-card-value">${df.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${df.band.color}">${df.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-df"></canvas>
                </div>

                <j:set var="leadTime" value="${it.leadTime}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Lead Time for Changes</div>
                    <div class="dora-card-value">${leadTime.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${leadTime.band.color}">${leadTime.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-lt"></canvas>
                </div>

                <j:set var="mttr" value="${it.mttr}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Mean Time to Restore</div>
                    <div class="dora-card-value">${mttr.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${mttr.band.color}">${mttr.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-mttr"></canvas>
                </div>

                <j:set var="cfr" value="${it.changeFailureRate}"/>
                <div class="dora-card">
                    <div class="dora-card-label">Change Failure Rate</div>
                    <div class="dora-card-value">${cfr.displayValue}</div>
                    <span class="dora-card-band" style="background-color: ${cfr.band.color}">${cfr.band.label}</span>
                    <canvas class="dora-sparkline" id="spark-cfr"></canvas>
                </div>
            </div>

            <!-- Trends -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>Trends</h2>
                    <span class="dora-section-toggle">&#9660;</span>
                </div>
                <div class="dora-section-body">
                    <div class="dora-chart-grid">
                        <div class="dora-chart-card">
                            <h3>Build Volume and Success Rate</h3>
                            <canvas id="chart-builds"></canvas>
                        </div>
                        <div class="dora-chart-card">
                            <h3>Average Build Duration (seconds)</h3>
                            <canvas id="chart-duration"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pipeline Rankings -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>Pipeline Rankings</h2>
                    <span class="dora-section-toggle">&#9660;</span>
                </div>
                <div class="dora-section-body">
                    <div class="dora-tables">
                        <div class="dora-table-wrap">
                            <h3>Slowest Pipelines</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Avg Duration</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.slowestPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Most Failing Pipelines</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Failure Rate</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.mostFailingPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Most Improved (vs Previous Period)</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Change</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.mostImprovedPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Flakiest Pipelines</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Pipeline</th><th class="v">Flaky Score</th><th class="v">Builds</th></tr>
                                <j:forEach var="p" items="${it.flakiestPipelines}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td class="jn"><a href="../${it.jobUrl(p.jobName)}/dora-metrics/" title="${p.jobName}">${p.jobName}</a></td><td class="v">${p.displayValue}</td><td class="v">${p.buildCount}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stage Analytics -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>Stage Analytics</h2>
                    <span class="dora-section-toggle">&#9660;</span>
                </div>
                <div class="dora-section-body">
                    <div class="dora-tables">
                        <div class="dora-table-wrap">
                            <h3>Slowest Stages</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Stage</th><th class="v">Avg Duration</th><th class="v">Runs</th></tr>
                                <j:forEach var="s" items="${it.slowestStages}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td>${s.stageName}</td><td class="v">${s.displayValue}</td><td class="v">${s.occurrences}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                        <div class="dora-table-wrap">
                            <h3>Most Failing Stages</h3>
                            <table class="dora-table">
                                <colgroup><col class="col-rank"/><col class="col-name"/><col class="col-val"/><col class="col-count"/></colgroup>
                                <tr><th class="r">#</th><th>Stage</th><th class="v">Failure Rate</th><th class="v">Runs</th></tr>
                                <j:forEach var="s" items="${it.mostFailingStages}" varStatus="i">
                                    <tr><td class="r">${i.index + 1}</td><td>${s.stageName}</td><td class="v">${s.displayValue}</td><td class="v">${s.occurrences}</td></tr>
                                </j:forEach>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- API -->
            <div class="dora-section">
                <div class="dora-section-header dora-toggle">
                    <h2>REST API</h2>
                    <span class="dora-section-toggle collapsed">&#9660;</span>
                </div>
                <div class="dora-section-body collapsed" style="max-height:0">
                    <div class="dora-api-info">
                        <p style="font-size:12px; margin:4px 0;">
                            <code>GET /dora-api/overview?days=30</code> All 4 DORA metrics<br/>
                            <code>GET /dora-api/pipelines?days=30&amp;limit=10</code> Pipeline rankings<br/>
                            <code>GET /dora-api/trends?days=90&amp;job=my-pipeline</code> Time-series data<br/>
                            <code>GET /dora-api/export?days=90&amp;format=csv</code> CSV/JSON export
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <script src="${resURL}/plugin/pipeline-dora-metrics/js/dora-dashboard.js"></script>
    </l:main-panel>
</l:layout>
</j:jelly>
