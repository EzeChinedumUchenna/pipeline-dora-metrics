<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="Endpoint URL" field="endpoint"
             description="e.g., https://s3.us-east-005.backblazeb2.com. Leave empty for AWS default.">
        <f:textbox/>
    </f:entry>
    <f:entry title="Bucket" field="bucket">
        <f:textbox/>
    </f:entry>
    <f:entry title="Credentials" field="credentialsId"
             description="Username = Access Key ID, Password = Secret Key.">
        <c:select/>
    </f:entry>
</j:jelly>
